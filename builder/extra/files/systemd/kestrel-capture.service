[Unit]
Description=kestrel WiFi capture (AngryOxide) on the USB adapter
After=NetworkManager.service
Wants=NetworkManager.service

[Service]
# The launcher exits 0 when capture is disabled or no adapter is present, so a
# clean exit is not restarted; an unexpected AngryOxide crash is.
ExecStart=/usr/local/lib/kestrel/capture-launch
Restart=on-failure
RestartSec=10
# On stop, systemd's SIGTERM goes to the launcher only (mixed), which asks
# AngryOxide to shut down cleanly with SIGINT and waits for it (up to 10 s, then
# kills it): SIGTERM would kill AngryOxide mid-write. Anything left after the
# launcher exits is killed; the timeout covers AngryOxide's clean stop.
KillMode=mixed
TimeoutStopSec=30

[Install]
WantedBy=multi-user.target
